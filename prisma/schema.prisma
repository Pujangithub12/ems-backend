  uploadedBy      User?          @relation(fields: [uploadedById], references: [id], onUpdate: NoAction, map: "FK_286bc0fe67648ee2952cd593d87")
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_97c340b593107b2a0c2587d6a71")

