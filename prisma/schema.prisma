  userId         Int?
  organizationId Int?                        @map("workspaceId")
  approvedAt     DateTime?                   @db.Timestamp(6)
  organization   Organization?               @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_b6dba08b81543b5e0d7bb823767")
  user           User?                       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_d56d559e2e6a044a392c69e3cce")

  @@map("expense_request")
}

model FileAccess {
  id             Int           @id(map: "PK_4f91934346cfc7e72466111a1bf") @default(autoincrement())
  granteeType    String        @db.VarChar
  role           String?       @db.VarChar
  level          String        @db.VarChar
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  fileId         Int?
  userId         Int?
  organizationId Int?          @map("workspaceId")
  grantedById    Int?
  file           ProjectFile?  @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_397ca282d50517817262e3427e6")
  user           User?         @relation("FileAccessUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_73775d0a6f317e5ca5723fb4d62")
  grantedBy      User?         @relation("FileAccessGrantedBy", fields: [grantedById], references: [id], onUpdate: NoAction, map: "FK_d04d9cb64c318657bedb974f466")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_e11d2995f1fa917c9659747bb22")

  @@map("file_access")
}

model HierarchyNode {
  id             Int      @id(map: "PK_e9cd770efa4b70707466c9c0631") @default(autoincrement())
  label          String?  @db.VarChar
  userId         Int?
  orderIndex     Int      @default(0)
  parentId       Int?
  organizationId Int      @map("workspaceId")
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  updatedAt      DateTime @default(now()) @db.Timestamp(6)

  organization       Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_17b19932d450eeac2967e910e8f")
  user               User?                           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_4bc247cadaffdfcbc8838048dae")
  parent             HierarchyNode?                  @relation("HierarchyNodeParent", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a6a4af743e28f998a054ffe2f3e")
  children           HierarchyNode[]                 @relation("HierarchyNodeParent")
  secondaryManagers  HierarchyNodeSecondaryManager[] @relation("HierarchyNodeSecondaryManagerNode1")
  secondaryManagerOf HierarchyNodeSecondaryManager[] @relation("HierarchyNodeSecondaryManagerNode2")

  @@map("hierarchy_node")
}

/// Join table backing HierarchyNode.secondaryManagers (uni-directional M2M in the app).
model HierarchyNodeSecondaryManager {
  hierarchyNodeId_1 Int
  hierarchyNodeId_2 Int
  node1             HierarchyNode @relation("HierarchyNodeSecondaryManagerNode1", fields: [hierarchyNodeId_1], references: [id], onDelete: Cascade, map: "FK_77ac9bbf532e1f93926a293af2d")
  node2             HierarchyNode @relation("HierarchyNodeSecondaryManagerNode2", fields: [hierarchyNodeId_2], references: [id], onDelete: Cascade, map: "FK_930c045bf27c4a18a516c21ae92")

  @@id([hierarchyNodeId_1, hierarchyNodeId_2], map: "PK_704ebfeafc488cc29738437c89f")
  @@index([hierarchyNodeId_1], map: "IDX_77ac9bbf532e1f93926a293af2")
  @@index([hierarchyNodeId_2], map: "IDX_930c045bf27c4a18a516c21ae9")
  @@map("hierarchy_node_secondary_managers_hierarchy_node")
}

