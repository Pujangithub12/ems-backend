generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int      @id(map: "PK_cace4a159ff9f2512dd42373760") @default(autoincrement())
  fullName           String   @db.VarChar
  email              String   @unique(map: "UQ_e12875dfb3b1d92d7d7c5377e22") @db.VarChar
  password           String   @db.VarChar
  phoneNumber        String   @db.VarChar
  address            String
  jobPosition        String   @db.VarChar
  joinDate           DateTime @db.Timestamp(6)
  createdAt          DateTime @default(now()) @db.Timestamp(6)
  /// Non-null for accounts locked to one organization via an accepted invite. No physical FK (see OrganizationInvite).
  homeOrganizationId Int?     @map("homeWorkspaceId")
  /// The organization this user was last active in — set on login (from here)
  /// and kept in sync by authMiddleware on every organization switch, so a
  /// fresh login lands back where the user left off instead of defaulting to
  /// their first membership. No physical FK, same as homeOrganizationId.
  lastOrganizationId Int?     @map("lastWorkspaceId")
  /// Bumped on password change/reset so previously-issued JWTs (which carry
  /// the version they were signed with) are rejected by authMiddleware —
  /// the only way to revoke a leaked/stolen token before its 3h expiry.
  tokenVersion       Int      @default(0)

  activities                        Activity[]
  expenseRequests                   ExpenseRequest[]
  fileAccessGranted                 FileAccess[]                 @relation("FileAccessUser")
  fileAccessGrantedBy               FileAccess[]                 @relation("FileAccessGrantedBy")
  hierarchyNodes                    HierarchyNode[]
  inventoryAttachmentsUploaded      InventoryAttachment[]
  inventoryItemsUpdated             InventoryItem[]
  inventoryTransactionsPerformed    InventoryTransaction[]
  leaveRequests                     LeaveRequest[]
  myTasks                           MyTask[]
  procurementAttachmentsUploaded    ProcurementAttachment[]
  procurementItemsRequested         ProcurementItem[]
  procurementStatusHistoryChanges   ProcurementStatusHistory[]
  purchaseOrderStatusHistoryChanges PurchaseOrderStatusHistory[]
  purchaseOrdersCreated             PurchaseOrder[]              @relation("PurchaseOrderCreatedBy")
  purchaseOrderPaymentsLogged       PurchaseOrderPayment[]
  financeManualRecordsCreated       FinanceManualRecord[]
  goodsReceiptsReceived             GoodsReceipt[]
  projectAssignments                ProjectAssignee[]
  projectFilesUploaded              ProjectFile[]
  siteActivityReportsCreated        SiteActivityReport[]
  siteVisitRequests                 SiteVisitRequest[]
  stockTransfersRequested           StockTransfer[]
  subTaskComments                   SubTaskComment[]
  createdTasks                      Task[]
  assignedTasks                     TaskAssignee[]
  taskComments                      TaskComment[]
  memberships                       OrganizationMembership[]
  notifications                     Notification[]

  @@map("user")
}

model Organization {
  id                 Int      @id(map: "PK_ca86b6f9b3be5fe26d307d09b49") @default(autoincrement())
  name               String   @db.VarChar
  description        String?  @db.VarChar
  createdAt          DateTime @default(now()) @db.Timestamp(6)
  address            String?
  contact            String?  @db.VarChar
  email              String?  @db.VarChar
  website            String?  @db.VarChar
  /// Storage key for the letterhead signature image used on generated Purchase Order PDFs (see purchaseOrderPdf.ts) — not the "uploads/" prefix, matching every other stored file path in this schema.
  signatureImagePath String?  @db.VarChar
  /// Storage key for the company seal/stamp image used on generated Purchase Order PDFs.
  stampImagePath     String?  @db.VarChar

  activities            Activity[]
  announcements         Announcement[]
  calendarEvents        CalendarEvent[]
  catalogItems          CatalogItem[]
  dailyGeneration       DailyGeneration[]
  expenseRequests       ExpenseRequest[]
  fileAccess            FileAccess[]
  hierarchyNodes        HierarchyNode[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  leaveRequests         LeaveRequest[]
  monthlyPerformance    MonthlyPerformance[]
  myTasks               MyTask[]
  procurementItems      ProcurementItem[]
  purchaseOrders        PurchaseOrder[]
  projects              Project[]
  projectFiles          ProjectFile[]
  projectHeadings       ProjectHeading[]
  siteVisitRequests     SiteVisitRequest[]
  tasks                 Task[]
  vendors               Vendor[]
  warehouses            Warehouse[]
  financeManualRecords  FinanceManualRecord[]
  memberships           OrganizationMembership[]
  notifications         Notification[]
  plantReportTables     PlantReportTable[]
  siteActivityReports   SiteActivityReport[]
  siteActivityWorkTypes SiteActivityWorkType[]

  @@map("workspace")
}

model OrganizationMembership {
  id             Int      @id(map: "PK_6641ba762220c1f1a86c9379e80") @default(autoincrement())
  role           String   @default("user") @db.VarChar
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  userId         Int
  organizationId Int      @map("workspaceId")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a78e067bc8a753d4b007bb066ba")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_eb8dad60593b84045c064a40b58")

  @@unique([userId, organizationId], map: "UQ_30e8373015a5fd312cc7df08fa5")
  @@map("workspace_membership")
}

model OrganizationInvite {
  id              Int       @id(map: "PK_731c4e491678e81c9dce6df62cb") @default(autoincrement())
  email           String    @unique(map: "UQ_a428a1440911f6fcb1e860a8ea7") @db.VarChar
  fullName        String    @db.VarChar
  phoneNumber     String?   @db.VarChar
  address         String?
  jobPosition     String?   @db.VarChar
  joinDate        DateTime? @db.Timestamp(6)
  role            String    @default("user") @db.VarChar
  /// Bare column, no physical FK (see Organization.ts recon note).
  organizationId  Int       @map("workspaceId")
  token           String    @unique(map: "UQ_6b616337ed3b3e6ac360bad6873") @db.VarChar
  expiresAt       DateTime  @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  /// Bare column, no physical FK.
  invitedByUserId Int?

  @@map("workspace_invite")
}

/// Legacy/orphaned table — no current TypeORM entity represented it either
/// (predates the codebase's tracked entities). Kept modeled for schema
/// completeness/data-safety but not read or written by any app code.
model Activity {
  id             Int           @id(map: "PK_24625a1d6b1b089c8ae206fe467") @default(autoincrement())
  type           String        @db.VarChar
  description    String
  taskId         Int?
  userId         Int?
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  organizationId Int?          @map("workspaceId")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_26dd80869eb20b6e4733e513d43")
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_2743f8990fde12f9586287eb09f")
  user           User?         @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "FK_3571467bcbe021f66e2bdce96ea")

  @@map("activity")
}

model Announcement {
  id             Int           @id(map: "PK_e0ef0550174fd1099a308fd18a0") @default(autoincrement())
  subject        String        @db.VarChar
  message        String
  targetType     String        @default("all") @db.VarChar
  targetEmails   String?
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  organizationId Int?          @map("workspaceId")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_6fb21e11779a6aa872a05bf6024")

  @@map("announcement")
}

model CalendarEvent {
  id             Int           @id(map: "PK_176fe24e6eb48c3fef696c7641f") @default(autoincrement())
  title          String        @db.VarChar
  date           DateTime      @db.Timestamp(6)
  type           String        @default("holiday") @db.VarChar
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  organizationId Int?          @map("workspaceId")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_59e2a27efcd9e693c42b4940e95")

  @@map("calendar_event")
}

model CatalogItem {
  id                   Int                   @id(map: "PK_8996a1f608499554f35bec8601e") @default(autoincrement())
  name                 String                @db.VarChar
  code                 String?               @db.VarChar
  createdAt            DateTime              @default(now()) @db.Timestamp(6)
  organizationId       Int?                  @map("workspaceId")
  organization         Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_805c3806878350a0875a5032d2c")
  inventoryItems       InventoryItem[]
  procurementItems     ProcurementItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  proformaInvoiceItems ProformaInvoiceItem[]

  @@map("catalog_item")
}

model ExpenseRequest {
  id             Int                         @id(map: "PK_5c1c32ee5afe4deecf34605433f") @default(autoincrement())
  title          String                      @default("Expense") @db.VarChar
  amount         Decimal                     @db.Decimal
  category       String                      @default("Other") @db.VarChar
  expenseDate    DateTime                    @db.Timestamp(6)
  reason         String
  status         expense_request_status_enum @default(pending)
  createdAt      DateTime                    @default(now()) @db.Timestamp(6)
  userId         Int?
  organizationId Int?                        @map("workspaceId")
  approvedAt     DateTime?                   @db.Timestamp(6)
  organization   Organization?               @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_b6dba08b81543b5e0d7bb823767")
  user           User?                       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_d56d559e2e6a044a392c69e3cce")

  @@map("expense_request")
}

model FileAccess {
  id             Int           @id(map: "PK_4f91934346cfc7e72466111a1bf") @default(autoincrement())
  granteeType    String        @db.VarChar
  role           String?       @db.VarChar
  level          String        @db.VarChar
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  fileId         Int?
  userId         Int?
  organizationId Int?          @map("workspaceId")
  grantedById    Int?
  file           ProjectFile?  @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_397ca282d50517817262e3427e6")
  user           User?         @relation("FileAccessUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_73775d0a6f317e5ca5723fb4d62")
  grantedBy      User?         @relation("FileAccessGrantedBy", fields: [grantedById], references: [id], onUpdate: NoAction, map: "FK_d04d9cb64c318657bedb974f466")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_e11d2995f1fa917c9659747bb22")

  @@map("file_access")
}

model HierarchyNode {
  id             Int      @id(map: "PK_e9cd770efa4b70707466c9c0631") @default(autoincrement())
  label          String?  @db.VarChar
  userId         Int?
  orderIndex     Int      @default(0)
  parentId       Int?
  organizationId Int      @map("workspaceId")
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  updatedAt      DateTime @default(now()) @db.Timestamp(6)

  organization       Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_17b19932d450eeac2967e910e8f")
  user               User?                           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_4bc247cadaffdfcbc8838048dae")
  parent             HierarchyNode?                  @relation("HierarchyNodeParent", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a6a4af743e28f998a054ffe2f3e")
  children           HierarchyNode[]                 @relation("HierarchyNodeParent")
  secondaryManagers  HierarchyNodeSecondaryManager[] @relation("HierarchyNodeSecondaryManagerNode1")
  secondaryManagerOf HierarchyNodeSecondaryManager[] @relation("HierarchyNodeSecondaryManagerNode2")

  @@map("hierarchy_node")
}

/// Join table backing HierarchyNode.secondaryManagers (uni-directional M2M in the app).
model HierarchyNodeSecondaryManager {
  hierarchyNodeId_1 Int
  hierarchyNodeId_2 Int
  node1             HierarchyNode @relation("HierarchyNodeSecondaryManagerNode1", fields: [hierarchyNodeId_1], references: [id], onDelete: Cascade, map: "FK_77ac9bbf532e1f93926a293af2d")
  node2             HierarchyNode @relation("HierarchyNodeSecondaryManagerNode2", fields: [hierarchyNodeId_2], references: [id], onDelete: Cascade, map: "FK_930c045bf27c4a18a516c21ae92")

  @@id([hierarchyNodeId_1, hierarchyNodeId_2], map: "PK_704ebfeafc488cc29738437c89f")
  @@index([hierarchyNodeId_1], map: "IDX_77ac9bbf532e1f93926a293af2")
  @@index([hierarchyNodeId_2], map: "IDX_930c045bf27c4a18a516c21ae9")
  @@map("hierarchy_node_secondary_managers_hierarchy_node")
}

model InventoryAttachment {
  id              Int            @id(map: "PK_f821b987181d85e608ed20a2f49") @default(autoincrement())
  fileName        String         @db.VarChar
  filePath        String         @db.VarChar
  createdAt       DateTime       @default(now()) @db.Timestamp(6)
  uploadedById    Int?
  inventoryItemId Int?
  uploadedBy      User?          @relation(fields: [uploadedById], references: [id], onUpdate: NoAction, map: "FK_286bc0fe67648ee2952cd593d87")
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_97c340b593107b2a0c2587d6a71")

  @@map("inventory_attachment")
}

model InventoryBatch {
  id              Int            @id(map: "PK_3883f580f1a93c37dba76d42f75") @default(autoincrement())
  batchNumber     String         @db.VarChar
  quantity        Int            @default(0)
  manufactureDate DateTime?      @db.Date
  expiryDate      DateTime?      @db.Date
  createdAt       DateTime       @default(now()) @db.Timestamp(6)
  inventoryItemId Int?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_b03ffc199d391e66de9e24a0294")

  @@map("inventory_batch")
}

model InventoryItem {
  id                 Int       @id(map: "PK_94f5cbcb5f280f2f30bd4a9fd90") @default(autoincrement())
  itemName           String    @db.VarChar
  category           String    @default("hardware") @db.VarChar
  quantity           Int       @default(0)
  status             String    @default("in_stock") @db.VarChar
  lastRestockedDate  DateTime? @db.Date
  notes              String?
  createdAt          DateTime  @default(now()) @db.Timestamp(6)
  updatedById        Int?
  projectId          Int?
  organizationId     Int?      @map("workspaceId")
  unit               String?   @db.VarChar
  sku                String?   @db.VarChar
  reservedQuantity   Int       @default(0)
  incomingQuantity   Int       @default(0)
  averageCost        Decimal?  @db.Decimal
  supplier           String?   @db.VarChar
  imageUrl           String?   @db.VarChar
  warrantyExpiryDate DateTime? @db.Date
  warehouseId        Int?
  vendorId           Int?
  itemId             Int?

  attachments  InventoryAttachment[]
  batches      InventoryBatch[]
  vendor       Vendor?                @relation(fields: [vendorId], references: [id], onUpdate: NoAction, map: "FK_03560bb52501c9d1316685356c4")
  item         CatalogItem?           @relation(fields: [itemId], references: [id], onUpdate: NoAction, map: "FK_21f08891af6b1afb9be05f27e3a")
  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_8a3f60ea0683e31e4cf2adcca29")
  project      Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a3f344bc8d6ba019dd2783bf153")
  warehouse    Warehouse?             @relation(fields: [warehouseId], references: [id], onUpdate: NoAction, map: "FK_acc2d1fe6c461484488183d5cfd")
  updatedBy    User?                  @relation(fields: [updatedById], references: [id], onUpdate: NoAction, map: "FK_dce2540f46fe0da89da3b6b41e4")
  serials      InventorySerial[]
  transactions InventoryTransaction[]
  transfers    StockTransfer[]

  @@map("inventory_item")
}

model InventorySerial {
  id                 Int            @id(map: "PK_246d447cfbb975407a4a7d063a2") @default(autoincrement())
  serialNumber       String         @db.VarChar
  status             String         @default("available") @db.VarChar
  warrantyExpiryDate DateTime?      @db.Date
  notes              String?
  createdAt          DateTime       @default(now()) @db.Timestamp(6)
  inventoryItemId    Int?
  inventoryItem      InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_de2a26f7582f6f868f39f727367")

  @@map("inventory_serial")
}

model InventoryTransaction {
  id                Int            @id(map: "PK_f58bbe29fa78f5b0d59d840d3ce") @default(autoincrement())
  type              String         @db.VarChar
  quantityChange    Int
  resultingQuantity Int
  reason            String?
  createdAt         DateTime       @default(now()) @db.Timestamp(6)
  performedById     Int?
  inventoryItemId   Int?
  organizationId    Int?           @map("workspaceId")
  inventoryItem     InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a1509b27d7c5c1a3011e2a32746")
  performedBy       User?          @relation(fields: [performedById], references: [id], onUpdate: NoAction, map: "FK_b51461369f6854e90adadc63729")
  organization      Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_c958bda03c283966e8536ac4971")

  @@map("inventory_transaction")
}

model LeaveRequest {
  id             Int                       @id(map: "PK_6f6ed3822203a4e10a5753368db") @default(autoincrement())
  startDate      DateTime                  @db.Timestamp(6)
  endDate        DateTime                  @db.Timestamp(6)
  reason         String
  createdAt      DateTime                  @default(now()) @db.Timestamp(6)
  userId         Int?
  title          String                    @default("Leave Request") @db.VarChar
  status         leave_request_status_enum @default(pending)
  organizationId Int?                      @map("workspaceId")
  approvedAt     DateTime?                 @db.Timestamp(6)
  user           User?                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_ccd082c03225c86d707142fa0dc")
  organization   Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_eb8ac0dcc12a5fa35c97622e153")

  @@map("leave_request")
}

model DailyGeneration {
  id                Int          @id @default(autoincrement())
  date              DateTime     @db.Date
  /**
   * = mainMeterFinal - mainMeterInitial, computed server-side on upsert.
   * Check Meter is a secondary displayed figure, never summed.
   */
  generation        Decimal?     @db.Decimal
  checkMeterInitial Decimal?     @db.Decimal
  checkMeterFinal   Decimal?     @db.Decimal
  mainMeterInitial  Decimal?     @db.Decimal
  mainMeterFinal    Decimal?     @db.Decimal
  createdAt         DateTime     @default(now())
  projectId         Int
  organizationId    Int
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
  @@map("daily_generation")
}

model MonthlyPerformance {
  id                 Int           @id(map: "PK_1f5cbe16154399ef2a09b922eff") @default(autoincrement())
  year               Int
  month              Int
  contractEnergy     Decimal?      @db.Decimal
  actualGeneration   Decimal?      @db.Decimal
  incomeReceived     Decimal?      @db.Decimal
  monthlyExpenditure Decimal?      @db.Decimal
  sparePartPurchase  Decimal?      @db.Decimal
  createdAt          DateTime      @default(now()) @db.Timestamp(6)
  projectId          Int?
  organizationId     Int?          @map("workspaceId")
  project            Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_32957898d80b5aca20065bc5d4a")
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_67d423e1ac881ab07e270b8eeea")

  @@index([projectId], map: "IDX_32957898d80b5aca20065bc5d4")
  @@map("monthly_performance")
}

model MyTask {
  id             Int           @id(map: "PK_5afe456c29a460d171e33a42c22") @default(autoincrement())
  title          String        @db.VarChar
  description    String?
  dueDate        DateTime?     @db.Date
  status         String        @default("pending") @db.VarChar
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  userId         Int?
  organizationId Int?          @map("workspaceId")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_6574ade0f1b9a8a753cd2888849")
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_7ce02825b211eb0f6c8515324e4")

  @@map("my_task")
}

/// Per-user, real-time notification (task assignment/completion, approval
/// request submitted/decided, announcement posted) — see notificationService.ts,
/// which creates these and pushes a matching socket.io event in one call.
model Notification {
  id             Int      @id @default(autoincrement())
  /// "task_assigned" | "task_completed" | "approval_requested" | "approval_decided" | "announcement"
  type           String   @db.VarChar
  title          String   @db.VarChar
  message        String
  /// Frontend route to deep-link into when clicked (e.g. a task or approvals page), organization prefix included.
  link           String?  @db.VarChar
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  userId         Int
  organizationId Int?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, isRead, createdAt])
  @@map("notification")
}

model PasswordResetOtp {
  id           Int      @id(map: "PK_74d5385a35ac0c619ca93815200") @default(autoincrement())
  email        String   @unique(map: "UQ_f064c1cfedfb0aca0a334aaa967") @db.VarChar
  otpCode      String   @db.VarChar
  otpExpiresAt DateTime @db.Timestamp(6)
  attempts     Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  @@map("password_reset_otp")
}

model PendingSignup {
  id           Int      @id(map: "PK_2d0b029dacccf96f58b57635e6c") @default(autoincrement())
  email        String   @unique(map: "UQ_535c0b5f98ba76bef7d9abb993b") @db.VarChar
  fullName     String   @db.VarChar
  password     String   @db.VarChar
  otpCode      String   @db.VarChar
  otpExpiresAt DateTime @db.Timestamp(6)
  attempts     Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  @@map("pending_signup")
}

/// A user-defined spreadsheet tab on the Plant Report page, scoped to one
/// project (an org can run more than one plant, each tracked separately).
/// "Progress Tracker" is just the first table auto-created per project (see
/// PlantReportTableController.list) — there's nothing structurally special
/// about it; every table has the same user-defined columns/rows shape, and
/// the "+" tab button on the frontend creates more of these.
model PlantReportTable {
  id             Int      @id @default(autoincrement())
  organizationId Int
  projectId      Int
  name           String   @db.VarChar
  sortOrder      Int      @default(0)
  /// True only for the "Progress Tracker" tab auto-created per project (see
  /// PlantReportTableController.list) — it and the frontend-only "Charts"
  /// tab are the page's two permanent tabs and can't be renamed or deleted.
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns      PlantReportColumn[]
  rows         PlantReportRow[]

  @@map("plant_report_table")
}

/// One user-defined column on a PlantReportTable. dataType is enforced in
/// the application layer (PlantReportTableController), not as a Postgres
/// enum, so new types can be added without a migration — same convention as
/// the rest of this codebase's org-defined-field features.
model PlantReportColumn {
  id        Int    @id @default(autoincrement())
  tableId   Int
  name      String @db.VarChar
  /// "text" | "number" | "date" | "boolean"
  dataType  String @db.VarChar
  sortOrder Int    @default(0)
  /// Optional flat expected/target value for a "number" column — rendered as
  /// a dashed horizontal reference line on the Charts tab for comparison
  /// against the column's actual data. Meaningless for non-number columns.
  target    Float?

  table PlantReportTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("plant_report_column")
}

/// One row of a PlantReportTable. Cell values are stored loosely as JSON
/// keyed by column id (as a string key) rather than in a normalized
/// per-cell table, since columns are low-cardinality and user-defined; a
/// deleted column just leaves an orphaned, ignored key behind instead of
/// requiring a cleanup pass (same convention this codebase already used for
/// PlantDailyReport.customValues).
model PlantReportRow {
  id        Int      @id @default(autoincrement())
  tableId   Int
  sortOrder Int      @default(0)
  values    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table PlantReportTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("plant_report_row")
}

/// One project's daily site report ("Site Activities" page/sidebar link) —
/// one per (project, reportDate). Distinct from PlantReportTable's generic
/// spreadsheet tabs: this is a fixed-shape daily log (work activities,
/// equipment, manpower, photos) matching the paper DPR form, not a
/// user-defined table.
model SiteActivityReport {
  id             Int      @id @default(autoincrement())
  organizationId Int
  projectId      Int
  reportDate     DateTime @db.Date
  location       String?  @db.VarChar
  /// Free-text Bikram Sambat date note (e.g. "2083 Bhadra 13") shown alongside reportDate on the Site Diary page — not computed/validated, just a manual annotation.
  reportDateBs   String?  @db.VarChar
  /// Free-text name shown on the Site Diary page's "Prepared by" field — distinct from createdBy (the app user who saved the entry).
  preparedBy     String?  @db.VarChar
  /// Freeform notes shown in the Site Diary's "Remarks / issues / concerns" footer panel.
  remarks        String?
  /// Name entered in the Site Diary's "Signature (site in-charge)" field — a typed name, not an image.
  signedBy       String?  @db.VarChar
  /// "draft" | "submitted"
  status         String   @default("submitted") @db.VarChar
  createdById    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  activities   SiteActivityItem[]
  equipment    SiteActivityEquipment[]
  manpower     SiteActivityManpower[]
  photos       SiteActivityPhoto[]
  weather      SiteActivityWeather[]
  materials    SiteActivityMaterial[]
  safety       SiteActivitySafety[]
  instructions SiteActivityInstruction[]

  @@unique([projectId, reportDate])
  @@map("site_activity_report")
}

/// One "Work Activities Progress" row on a SiteActivityReport.
model SiteActivityItem {
  id          Int     @id @default(autoincrement())
  reportId    Int
  sortOrder   Int     @default(0)
  description String  @db.VarChar
  chainage    String? @db.VarChar
  todayQty    Float?
  unit        String? @db.VarChar
  /// "ongoing" | "completed"
  status      String  @default("ongoing") @db.VarChar
  remarks     String? @db.VarChar

  report SiteActivityReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  photos SiteActivityPhoto[]

  @@map("site_activity_item")
}

/// One "Equipment & Machinery Log" row on a SiteActivityReport.
model SiteActivityEquipment {
  id            Int     @id @default(autoincrement())
  reportId      Int
  sortOrder     Int     @default(0)
  equipmentName String  @db.VarChar
  quantity      Int     @default(1)
  workingHours  Float?
  /// "working" | "idle" | "breakdown"
  condition     String  @default("working") @db.VarChar
  remarks       String? @db.VarChar

  report SiteActivityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("site_activity_equipment")
}

/// One "Manpower Breakdown" row on a SiteActivityReport — a free-text role
/// label (e.g. "Site Engineer") rather than an enum, so an org can use
/// whatever role names their site actually has.
model SiteActivityManpower {
  id        Int     @id @default(autoincrement())
  reportId  Int
  sortOrder Int     @default(0)
  role      String  @db.VarChar
  headcount Int     @default(0)
  /// Free-text names, filled in only for specific posts (e.g. named engineers) — most rows leave this blank and just report a headcount.
  names     String? @db.VarChar
  remarks   String? @db.VarChar

  report SiteActivityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("site_activity_manpower")
}

/// One "Site Photographs" entry — optionally tied to a specific work
/// activity row (itemId), otherwise just attached to the report generally.
model SiteActivityPhoto {
  id         Int      @id @default(autoincrement())
  reportId   Int
  itemId     Int?
  filePath   String   @db.VarChar
  fileName   String   @db.VarChar
  caption    String?  @db.VarChar
  uploadedAt DateTime @default(now())

  report SiteActivityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  item   SiteActivityItem?  @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@map("site_activity_photo")
}

/// One "Weather Status" row on a SiteActivityReport — exactly one per slot
/// ("morning" | "afternoon" | "evening"), matching the paper DPR form's
/// fixed 3-row weather block.
model SiteActivityWeather {
  id        Int     @id @default(autoincrement())
  reportId  Int
  /// "morning" | "afternoon" | "evening"
  slot      String  @db.VarChar
  condition String? @db.VarChar
  tempC     Float?
  /// "no_rainfall" | "light" | "moderate" | "heavy"
  rainfall  String? @db.VarChar
  remarks   String? @db.VarChar

  report SiteActivityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, slot])
  @@map("site_activity_weather")
}

/// One "Materials" row on a SiteActivityReport — separate quantity/unit
/// pairs for "Received at site" vs "Used at site" (e.g. 1000 CFT received,
/// 0 CFT used yet), rather than a single quantity with two booleans.
model SiteActivityMaterial {
  id               Int     @id @default(autoincrement())
  reportId         Int
  sortOrder        Int     @default(0)
  materialType     String  @db.VarChar
  receivedQuantity Float?
  receivedUnit     String? @db.VarChar
  usedQuantity     Float?
  usedUnit         String? @db.VarChar
  remarks          String? @db.VarChar

  report SiteActivityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("site_activity_material")
}

/// One "Safety" row (observation or incident) on a SiteActivityReport.
model SiteActivitySafety {
  id          Int     @id @default(autoincrement())
  reportId    Int
  sortOrder   Int     @default(0)
  /// "observation" | "incident"
  type        String  @db.VarChar
  description String? @db.VarChar
  actionTaken String? @db.VarChar

  report SiteActivityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("site_activity_safety")
}

/// One "Instructions" row on a SiteActivityReport.
model SiteActivityInstruction {
  id          Int     @id @default(autoincrement())
  reportId    Int
  sortOrder   Int     @default(0)
  description String? @db.VarChar
  byWhom      String? @db.VarChar
  toWhom      String? @db.VarChar
  time        String? @db.VarChar
  signatureOf String? @db.VarChar

  report SiteActivityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("site_activity_instruction")
}

/// Org-wide reusable predefined-options vocabulary for the Site Diary's
/// Work Activities / Equipment / Materials tables — `kind` distinguishes
/// which dropdown an option belongs to ("activity" | "equipment" |
/// "material"). Not a rigid enum: SiteActivityController.save() auto-adds
/// any new value typed in, so each list grows organically instead of
/// needing separate admin CRUD.
model SiteActivityWorkType {
  id             Int      @id @default(autoincrement())
  organizationId Int
  kind           String   @default("activity") @db.VarChar
  name           String   @db.VarChar
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, name])
  @@map("site_activity_work_type")
}

model ProcurementAttachment {
  id                Int              @id(map: "PK_7daf4aef8c39d882b308044813f") @default(autoincrement())
  fileName          String           @db.VarChar
  filePath          String           @db.VarChar
  createdAt         DateTime         @default(now()) @db.Timestamp(6)
  uploadedById      Int?
  procurementItemId Int?
  procurementItem   ProcurementItem? @relation(fields: [procurementItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_608fffab95a5c24356850767cbf")
  uploadedBy        User?            @relation(fields: [uploadedById], references: [id], onUpdate: NoAction, map: "FK_d719e36702a5589c5bc8d293468")

  @@map("procurement_attachment")
}

model ProcurementItem {
  id              Int       @id(map: "PK_58dd75ddfa3fb86cad02d0dea32") @default(autoincrement())
  itemName        String    @db.VarChar
  quantity        Int       @default(1)
  estimatedCost   Decimal?  @db.Decimal
  neededByDate    DateTime? @db.Date
  notes           String?
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  requestedById   Int?
  projectId       Int?
  organizationId  Int?      @map("workspaceId")
  category        String    @default("hardware") @db.VarChar
  status          String    @default("pending") @db.VarChar
  poNumber        String?   @db.VarChar
  unitCost        Decimal?  @db.Decimal
  vendorName      String?   @db.VarChar
  vendorId        Int?
  itemId          Int?
  unit            String?   @db.VarChar
  taxPercent      Decimal?  @db.Decimal
  discountPercent Decimal?  @db.Decimal
  transportCost   Decimal?  @db.Decimal
  customsCost     Decimal?  @db.Decimal

  attachments   ProcurementAttachment[]
  organization  Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_60c7d17e44ffa1db2d1d1a90c08")
  item          CatalogItem?               @relation(fields: [itemId], references: [id], onUpdate: NoAction, map: "FK_962531b78f7e84a1af9bbed3c5c")
  requestedBy   User?                      @relation(fields: [requestedById], references: [id], onUpdate: NoAction, map: "FK_af07f3da6e978a7e1fc31c777be")
  vendor        Vendor?                    @relation(fields: [vendorId], references: [id], onUpdate: NoAction, map: "FK_c491225838280a413ee9b77c407")
  project       Project?                   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_e13850e5ad77122dc1b16cec387")
  statusHistory ProcurementStatusHistory[]

  @@map("procurement_item")
}

model ProcurementStatusHistory {
  id                Int              @id(map: "PK_86317a5b57832295d35505b6bb9") @default(autoincrement())
  fromStatus        String?          @db.VarChar
  toStatus          String           @db.VarChar
  notes             String?
  createdAt         DateTime         @default(now()) @db.Timestamp(6)
  changedById       Int?
  procurementItemId Int?
  procurementItem   ProcurementItem? @relation(fields: [procurementItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_97498b499ec7e4bf975c91b94b4")
  changedBy         User?            @relation(fields: [changedById], references: [id], onUpdate: NoAction, map: "FK_b6176ad2735eee052610b6e011f")

  @@map("procurement_status_history")
}

// ---------------------------------------------------------------------------
// Procurement pipeline v2: Purchase Order -> Proforma Invoice ->
// (Local/International) Shipment/Insurance/Customs -> Cost Sheet (computed)
// -> Goods Receipt -> Inventory. Purchase Orders are created directly
// (PurchaseOrderController.createPurchaseOrder) — there used to be a
// Purchase Request + Vendor Selection step ahead of this, removed along with
// its data. ProcurementItem/ProcurementAttachment/ProcurementStatusHistory
// above stay in the DB untouched for historical data.
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id                    Int      @id @default(autoincrement())
  poNumber              String?  @db.VarChar
  paymentTerms          String?  @db.VarChar
  incoterms             String?  @db.VarChar
  taxPercent            Decimal? @db.Decimal
  terms                 String?
  /// Free-text delivery period for the PO PDF (e.g. "Within 6 weeks of submission of PO.").
  deliveryPeriod        String?
  finalDestination      String?
  /// Contact person name for the PDF's CUSTOMER box ("NAME OF CONTACT PERSON") — the buying organization's own contact, distinct from the vendor's contactPerson on the Vendor record.
  customerContactPerson String?
  /// Free-text currency label for the PDF's "Amount in Words" line (e.g. "Indian Rupees", "US Dollar") — falls back to "Rupees" when unset, see purchaseOrderPdf.ts.
  currency              String?  @db.VarChar
  /// "local" | "international" — drives whether Insurance/Customs apply, see PurchaseType in types/domain.ts
  purchaseType          String   @default("local") @db.VarChar
  status                String   @default("created") @db.VarChar
  /// Whoever created this PO — plain admins only see/edit POs they created themselves (see
  /// PurchaseOrderController); finance/super_admin see everything.
  createdById           Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt
  vendorId              Int?
  projectId             Int?
  organizationId        Int?

  vendor           Vendor?                      @relation(fields: [vendorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdBy        User?                        @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  project          Project?                     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization     Organization?                @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items            PurchaseOrderItem[]
  statusHistory    PurchaseOrderStatusHistory[]
  proformaInvoices ProformaInvoice[]
  shipment         Shipment?
  goodsReceipts    GoodsReceipt[]
  payments         PurchaseOrderPayment[]

  @@map("purchase_order")
}

/// Finance's payment log against a PO or a manual finance record — a PO/record can be paid in
/// installments, so this is a one-to-many history rather than a single amount-paid field.
/// Exactly one of purchaseOrderId/manualRecordId is set per row.
model PurchaseOrderPayment {
  id              Int      @id @default(autoincrement())
  amount          Decimal  @db.Decimal
  paidDate        DateTime @db.Date
  /// e.g. bank transfer reference / cheque number.
  reference       String?  @db.VarChar
  notes           String?
  createdAt       DateTime @default(now())
  purchaseOrderId Int?
  manualRecordId  Int?
  createdById     Int?

  purchaseOrder PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  manualRecord  FinanceManualRecord? @relation(fields: [manualRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy     User?                @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("purchase_order_payment")
}

/// A Finance ledger row entered directly on the Finance page, not derived from a real
/// PurchaseOrder — for tracking payments/balances that don't have (or don't yet have) a PO
/// behind them. Shares the PurchaseOrderPayment log for its payment history.
model FinanceManualRecord {
  id              Int      @id @default(autoincrement())
  vendorName      String   @db.VarChar
  itemName        String   @db.VarChar
  /// Free-text procurement/reference identifier — the manual-record equivalent of PurchaseOrder.poNumber.
  referenceNumber String?  @db.VarChar
  itemValue       Decimal  @db.Decimal
  /// "NPR" | "INR" | "USD" | "RMB" — set on the Finance page's Add/Edit Record form.
  currency        String   @default("NPR") @db.VarChar
  paymentTerms    String?  @db.VarChar
  /// The following mirror the Finance cost-breakdown page's columns for a PO row — plain stored
  /// fields here (no shipment/proration behind a manual record, unlike PurchaseOrderItem's
  /// override columns below).
  freight         Decimal? @db.Decimal
  lcNumber        String?  @db.VarChar
  lcCharge        Decimal? @db.Decimal
  lcCommission    Decimal? @db.Decimal
  vat             Decimal? @db.Decimal
  /// VAT-refund tracking (Finance cost-breakdown page): how much of this record's VAT has
  /// actually been refunded so far. Refundable Amount is no longer tracked per-margin (that
  /// column was removed), so it's always treated as 0 here.
  refundedAmount  Decimal? @db.Decimal
  /// Freeform note shown on the record's Finance cost-breakdown page.
  remarks         String?
  createdAt       DateTime @default(now())
  organizationId  Int?
  /// Optional link to a real Vendor so this record's totals fold into that vendor's Finance drilldown page.
  vendorId        Int?
  createdById     Int?

  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendor       Vendor?                @relation(fields: [vendorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdBy    User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payments     PurchaseOrderPayment[]

  @@map("finance_manual_record")
}

/// Snapshot copy of the selected PurchaseRequestItem rows at PO-generation time — not a live reference, so the PO stays stable if the PR is later edited.
model PurchaseOrderItem {
  id                   Int      @id @default(autoincrement())
  itemName             String   @db.VarChar
  quantity             Float    @default(1)
  unit                 String?  @db.VarChar
  unitPrice            Decimal? @db.Decimal
  /// Entered on the Overview tab's "Add Item" form — shown under the item name in the PDF's Product Description cell.
  description          String?
  /// HS (Harmonized System) customs code for the PO PDF's line-item table — filled in manually, usually only relevant for international purchases.
  hsnCode              String?  @db.VarChar
  /// The following let the Finance cost-breakdown page override this item's computed share of
  /// the PO's freight/LC charge/LC commission/VAT (normally prorated from Shipment/Customs/
  /// LetterOfCredit by this item's value share — see computeCostSheet/buildPoCostBreakdownRows).
  /// Null means "use the computed proration"; a non-null value here wins.
  freightOverride      Decimal? @db.Decimal
  lcChargeOverride     Decimal? @db.Decimal
  lcCommissionOverride Decimal? @db.Decimal
  vatOverride          Decimal? @db.Decimal
  /// VAT-refund tracking (Finance cost-breakdown page): how much of this item's VAT (see
  /// vatOverride above) has actually been refunded so far. Refundable Amount is no longer
  /// tracked per-margin (that column was removed), so it's always treated as 0 here.
  refundedAmount       Decimal? @db.Decimal
  /// Freeform note shown on the PO's Finance cost-breakdown page (not printed on the PO PDF).
  remarks              String?
  createdAt            DateTime @default(now())
  purchaseOrderId      Int?
  itemId               Int?

  purchaseOrder     PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item              CatalogItem?       @relation(fields: [itemId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  goodsReceiptItems GoodsReceiptItem[]

  @@map("purchase_order_item")
}

model PurchaseOrderStatusHistory {
  id              Int      @id @default(autoincrement())
  fromStatus      String?  @db.VarChar
  toStatus        String   @db.VarChar
  notes           String?
  createdAt       DateTime @default(now())
  changedById     Int?
  purchaseOrderId Int?

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changedBy     User?          @relation(fields: [changedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("purchase_order_status_history")
}

model ProformaInvoice {
  id                  Int       @id @default(autoincrement())
  piNumber            String?   @db.VarChar
  piDate              DateTime? @db.Date
  currency            String    @default("NPR") @db.VarChar
  exchangeRate        Decimal   @default(1) @db.Decimal
  paymentTerms        String?   @db.VarChar
  validityDate        DateTime? @db.Date
  /// Single PDF attachment per spec ("Attachment (PDF)") — not a join table since only one file is expected.
  fileName            String?   @db.VarChar
  filePath            String?   @db.VarChar
  status              String    @default("waiting") @db.VarChar
  /// VAT % applied to taxable line items only (see ProformaInvoiceItem.taxable) on the generated PDF — falls back to 13 when unset.
  taxPercent          Decimal?  @db.Decimal
  /// PAN fields for the PDF's CUSTOMER/VENDOR boxes — kept on the PI itself (not Vendor/Organization master data) since they're filled in per-invoice.
  customerPan         String?   @db.VarChar
  vendorPan           String?   @db.VarChar
  /// Bank Details box on the PDF.
  bankBeneficiaryName String?   @db.VarChar
  bankAccountNumber   String?   @db.VarChar
  bankName            String?   @db.VarChar
  bankSwiftCode       String?   @db.VarChar
  bankAddress         String?
  /// Terms of Delivery box on the PDF.
  deliveryTerms       String?   @db.VarChar
  placeOfLoading      String?   @db.VarChar
  placeOfDischarge    String?   @db.VarChar
  modeOfShipment      String?   @db.VarChar
  /// Free-text NOTES section on the PDF.
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  purchaseOrderId     Int?

  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items         ProformaInvoiceItem[]

  @@map("proforma_invoice")
}

model ProformaInvoiceItem {
  id                Int      @id @default(autoincrement())
  itemName          String   @db.VarChar
  quantity          Int      @default(1)
  unit              String?  @db.VarChar
  unitPrice         Decimal? @db.Decimal
  /// HS (Harmonized System) customs code for the PI PDF's line-item table.
  hsnCode           String?  @db.VarChar
  /// Whether this line item is subject to VAT on the PI PDF — non-taxable items are summed separately from taxable ones (see ProformaInvoice.taxPercent).
  taxable           Boolean  @default(true)
  createdAt         DateTime @default(now())
  proformaInvoiceId Int?
  itemId            Int?

  proformaInvoice ProformaInvoice? @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item            CatalogItem?     @relation(fields: [itemId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("proforma_invoice_item")
}

/// Serves both Local and International purchases (spec: "everything afterwards depends on [purchase type]") — Local just never gets an Insurance/Customs child row.
model Shipment {
  id                Int       @id @default(autoincrement())
  shipmentNo        String?   @db.VarChar
  transportMode     String    @default("road") @db.VarChar
  transportCompany  String?   @db.VarChar
  containerNo       String?   @db.VarChar
  vehicleNo         String?   @db.VarChar
  trackingNo        String?   @db.VarChar
  etd               DateTime? @db.Date
  eta               DateTime? @db.Date
  arrivalDate       DateTime? @db.Date
  status            String    @default("booked") @db.VarChar
  freightCost       Decimal?  @db.Decimal
  loadingCost       Decimal?  @db.Decimal
  unloadingCost     Decimal?  @db.Decimal
  fuelCost          Decimal?  @db.Decimal
  miscellaneousCost Decimal?  @db.Decimal
  /// Local-purchase-only cost line (spec's "Local Taxes" under the Local workflow).
  localTaxCost      Decimal?  @db.Decimal
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  purchaseOrderId   Int?      @unique

  purchaseOrder  PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  insurance      Insurance?
  customs        Customs?
  letterOfCredit LetterOfCredit?

  @@map("shipment")
}

/// Optional, only created for shipments where it's applicable (per spec: "Only if applicable").
model Insurance {
  id                 Int      @id @default(autoincrement())
  insuranceCompany   String?  @db.VarChar
  policyNumber       String?  @db.VarChar
  coverage           Decimal? @db.Decimal
  premium            Decimal? @db.Decimal
  claimStatus        String?  @db.VarChar
  attachmentFileName String?  @db.VarChar
  attachmentFilePath String?  @db.VarChar
  createdAt          DateTime @default(now())
  shipmentId         Int?     @unique

  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("insurance")
}

/// International purchases only — optional, mirrors Insurance's shape (per spec: "Only if applicable").
model LetterOfCredit {
  id           Int      @id @default(autoincrement())
  lcNumber     String?  @db.VarChar
  lcCharge     Decimal? @db.Decimal
  lcCommission Decimal? @db.Decimal
  createdAt    DateTime @default(now())
  shipmentId   Int?     @unique

  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

