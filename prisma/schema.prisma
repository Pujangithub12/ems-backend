  category           String    @default("hardware") @db.VarChar
  quantity           Int       @default(0)
  status             String    @default("in_stock") @db.VarChar
  lastRestockedDate  DateTime? @db.Date
  notes              String?
  createdAt          DateTime  @default(now()) @db.Timestamp(6)
  updatedById        Int?
  projectId          Int?
  organizationId     Int?      @map("workspaceId")
  unit               String?   @db.VarChar
  sku                String?   @db.VarChar
  reservedQuantity   Int       @default(0)
  incomingQuantity   Int       @default(0)
  averageCost        Decimal?  @db.Decimal
  supplier           String?   @db.VarChar
  imageUrl           String?   @db.VarChar
  warrantyExpiryDate DateTime? @db.Date
  warehouseId        Int?
  vendorId           Int?
  itemId             Int?

  attachments  InventoryAttachment[]
  batches      InventoryBatch[]
  vendor       Vendor?                @relation(fields: [vendorId], references: [id], onUpdate: NoAction, map: "FK_03560bb52501c9d1316685356c4")
  item         CatalogItem?           @relation(fields: [itemId], references: [id], onUpdate: NoAction, map: "FK_21f08891af6b1afb9be05f27e3a")
  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_8a3f60ea0683e31e4cf2adcca29")
  project      Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a3f344bc8d6ba019dd2783bf153")
  warehouse    Warehouse?             @relation(fields: [warehouseId], references: [id], onUpdate: NoAction, map: "FK_acc2d1fe6c461484488183d5cfd")
  updatedBy    User?                  @relation(fields: [updatedById], references: [id], onUpdate: NoAction, map: "FK_dce2540f46fe0da89da3b6b41e4")
  serials      InventorySerial[]
  transactions InventoryTransaction[]
  transfers    StockTransfer[]

