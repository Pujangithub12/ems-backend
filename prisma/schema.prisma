generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Every model/field below is renamed for the app-facing "Organization"
// terminology while the physical tables/columns stay pinned to their
// original "workspace" names via @@map/@map — see CLAUDE.md's "Multi-tenant
// organization model" section. This schema was generated by introspecting
// the live DB (`prisma db pull`) and then renamed; no DDL has been applied.
// ---------------------------------------------------------------------------

model User {
  id                 Int      @id(map: "PK_cace4a159ff9f2512dd42373760") @default(autoincrement())
  fullName           String   @db.VarChar
  email              String   @unique(map: "UQ_e12875dfb3b1d92d7d7c5377e22") @db.VarChar
  password           String   @db.VarChar
  phoneNumber        String   @db.VarChar
  address            String
  jobPosition        String   @db.VarChar
  joinDate           DateTime @db.Timestamp(6)
  createdAt          DateTime @default(now()) @db.Timestamp(6)
  /// Non-null for accounts locked to one organization via an accepted invite. No physical FK (see OrganizationInvite).
  homeOrganizationId Int?     @map("homeWorkspaceId")
  /// The organization this user was last active in — set on login (from here)
  /// and kept in sync by authMiddleware on every organization switch, so a
  /// fresh login lands back where the user left off instead of defaulting to
  /// their first membership. No physical FK, same as homeOrganizationId.
  lastOrganizationId Int?     @map("lastWorkspaceId")
  /// Bumped on password change/reset so previously-issued JWTs (which carry
  /// the version they were signed with) are rejected by authMiddleware —
  /// the only way to revoke a leaked/stolen token before its 3h expiry.
  tokenVersion       Int      @default(0)

  activities                          Activity[]
  expenseRequests                     ExpenseRequest[]
  fileAccessGranted                   FileAccess[]                   @relation("FileAccessUser")
  fileAccessGrantedBy                 FileAccess[]                   @relation("FileAccessGrantedBy")
  hierarchyNodes                      HierarchyNode[]
  inventoryAttachmentsUploaded        InventoryAttachment[]
  inventoryItemsUpdated               InventoryItem[]
  inventoryTransactionsPerformed      InventoryTransaction[]
  leaveRequests                       LeaveRequest[]
  myTasks                             MyTask[]
  procurementAttachmentsUploaded      ProcurementAttachment[]
  procurementItemsRequested           ProcurementItem[]
  procurementStatusHistoryChanges     ProcurementStatusHistory[]
  purchaseRequestsRequested           PurchaseRequest[]
  purchaseRequestAttachmentsUploaded  PurchaseRequestAttachment[]
  purchaseRequestStatusHistoryChanges PurchaseRequestStatusHistory[]
  purchaseOrderAttachmentsUploaded    PurchaseOrderAttachment[]
  purchaseOrderStatusHistoryChanges   PurchaseOrderStatusHistory[]
  goodsReceiptsReceived               GoodsReceipt[]
  projectAssignments                  ProjectAssignee[]
  projectFilesUploaded                ProjectFile[]
  reportActivities                    ReportActivity[]
  reportComments                      ReportComment[]
  siteVisitRequests                   SiteVisitRequest[]
  stockTransfersRequested             StockTransfer[]
  subTaskComments                     SubTaskComment[]
  createdTasks                        Task[]
  assignedTasks                       TaskAssignee[]
  taskComments                        TaskComment[]
  memberships                         OrganizationMembership[]
  notifications                       Notification[]
  plantDailyReportsCreated            PlantDailyReport[]
  plantReportStaffEntries             PlantReportStaff[]

  @@map("user")
}

model Organization {
  id          Int      @id(map: "PK_ca86b6f9b3be5fe26d307d09b49") @default(autoincrement())
  name        String   @db.VarChar
  description String?  @db.VarChar
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  address     String?
  contact     String?  @db.VarChar
  email       String?  @db.VarChar
  website     String?  @db.VarChar

  activities              Activity[]
  announcements           Announcement[]
  calendarEvents          CalendarEvent[]
  catalogItems            CatalogItem[]
  dailyGeneration         DailyGeneration[]
  expenseRequests         ExpenseRequest[]
  fileAccess              FileAccess[]
  hierarchyNodes          HierarchyNode[]
  inventoryItems          InventoryItem[]
  inventoryTransactions   InventoryTransaction[]
  leaveRequests           LeaveRequest[]
  monthlyPerformance      MonthlyPerformance[]
  myTasks                 MyTask[]
  procurementItems        ProcurementItem[]
  purchaseRequests        PurchaseRequest[]
  purchaseOrders          PurchaseOrder[]
  projects                Project[]
  projectFiles            ProjectFile[]
  projectHeadings         ProjectHeading[]
  reportActivities        ReportActivity[]
  reportComments          ReportComment[]
  siteVisitRequests       SiteVisitRequest[]
  tasks                   Task[]
  vendors                 Vendor[]
  warehouses              Warehouse[]
  memberships             OrganizationMembership[]
  notifications           Notification[]
  plantDailyReports       PlantDailyReport[]
  plantReportCustomFields PlantReportCustomField[]
  plantReportItems        PlantReportItem[]

  @@map("workspace")
}

model OrganizationMembership {
  id             Int      @id(map: "PK_6641ba762220c1f1a86c9379e80") @default(autoincrement())
  role           String   @default("user") @db.VarChar
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  userId         Int
  organizationId Int      @map("workspaceId")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a78e067bc8a753d4b007bb066ba")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_eb8dad60593b84045c064a40b58")

  @@unique([userId, organizationId], map: "UQ_30e8373015a5fd312cc7df08fa5")
  @@map("workspace_membership")
}

model OrganizationInvite {
  id              Int       @id(map: "PK_731c4e491678e81c9dce6df62cb") @default(autoincrement())
  email           String    @unique(map: "UQ_a428a1440911f6fcb1e860a8ea7") @db.VarChar
  fullName        String    @db.VarChar
  phoneNumber     String?   @db.VarChar
  address         String?
  jobPosition     String?   @db.VarChar
  joinDate        DateTime? @db.Timestamp(6)
  role            String    @default("user") @db.VarChar
  /// Bare column, no physical FK (see Organization.ts recon note).
  organizationId  Int       @map("workspaceId")
  token           String    @unique(map: "UQ_6b616337ed3b3e6ac360bad6873") @db.VarChar
  expiresAt       DateTime  @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  /// Bare column, no physical FK.
  invitedByUserId Int?

  @@map("workspace_invite")
}

/// Legacy/orphaned table — no current TypeORM entity represented it either
/// (predates the codebase's tracked entities). Kept modeled for schema
/// completeness/data-safety but not read or written by any app code.
model Activity {
  id             Int           @id(map: "PK_24625a1d6b1b089c8ae206fe467") @default(autoincrement())
  type           String        @db.VarChar
  description    String
  taskId         Int?
  userId         Int?
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  organizationId Int?          @map("workspaceId")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_26dd80869eb20b6e4733e513d43")
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_2743f8990fde12f9586287eb09f")
  user           User?         @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "FK_3571467bcbe021f66e2bdce96ea")

  @@map("activity")
}

model Announcement {
  id             Int           @id(map: "PK_e0ef0550174fd1099a308fd18a0") @default(autoincrement())
  subject        String        @db.VarChar
  message        String
  targetType     String        @default("all") @db.VarChar
  targetEmails   String?
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  organizationId Int?          @map("workspaceId")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_6fb21e11779a6aa872a05bf6024")

  @@map("announcement")
}

model CalendarEvent {
  id             Int           @id(map: "PK_176fe24e6eb48c3fef696c7641f") @default(autoincrement())
  title          String        @db.VarChar
  date           DateTime      @db.Timestamp(6)
  type           String        @default("holiday") @db.VarChar
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  organizationId Int?          @map("workspaceId")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_59e2a27efcd9e693c42b4940e95")

  @@map("calendar_event")
}

model CatalogItem {
  id                   Int                   @id(map: "PK_8996a1f608499554f35bec8601e") @default(autoincrement())
  name                 String                @db.VarChar
  code                 String?               @db.VarChar
  createdAt            DateTime              @default(now()) @db.Timestamp(6)
  organizationId       Int?                  @map("workspaceId")
  organization         Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_805c3806878350a0875a5032d2c")
  inventoryItems       InventoryItem[]
  procurementItems     ProcurementItem[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  proformaInvoiceItems ProformaInvoiceItem[]

  @@map("catalog_item")
}

model ExpenseRequest {
  id             Int                         @id(map: "PK_5c1c32ee5afe4deecf34605433f") @default(autoincrement())
  title          String                      @default("Expense") @db.VarChar
  amount         Decimal                     @db.Decimal
