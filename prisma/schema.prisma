/// Deprecated — superseded by Task's parentTaskId/startDate/duration/orderIndex
/// columns (Schedule and Task tabs now share the Task table). Left in place,
/// unwritten by new code, for historical/rollback safety; see
/// migrate-schedule-to-task.ts for the one-off backfill into Task.
model ScheduleTask {
  id            Int                @id(map: "PK_b184187cc1517c0972cedc4f0b6") @default(autoincrement())
  projectId     Int
  taskId        String             @db.VarChar
  taskName      String             @db.VarChar
  duration      Float?
  startDate     DateTime?          @db.Date
  parentId      String?            @db.VarChar
  /// Deprecated — superseded by ScheduleTaskLink (real FK-backed table with dependency type + lag). Left in place, unwritten by new code, for historical/rollback safety; see ScheduleTaskLink for the current model.
  predecessorId String?            @db.VarChar
  orderIndex    Int                @default(0)
  createdAt     DateTime           @default(now()) @db.Timestamp(6)
  updatedAt     DateTime           @default(now()) @db.Timestamp(6)
  progress      Float?
  status        String             @default("to_do") @db.VarChar
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_4a5d5f0b5eb1490a8e704b07035")
  outgoingLinks ScheduleTaskLink[] @relation("ScheduleTaskLinkPredecessor")
  incomingLinks ScheduleTaskLink[] @relation("ScheduleTaskLinkSuccessor")

  @@index([projectId], map: "IDX_4a5d5f0b5eb1490a8e704b0703")
  @@map("schedule_task")
}

/// Deprecated — superseded by TaskLink (same shape, FK-backed against Task
/// instead of ScheduleTask). Left in place, unwritten by new code, for
/// historical/rollback safety.
model ScheduleTaskLink {
  id            Int      @id @default(autoincrement())
  projectId     Int
  predecessorId Int
  successorId   Int
  /// FS | SS | FF | SF
  type          String   @default("FS") @db.VarChar
  lagDays       Float    @default(0)
  createdAt     DateTime @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  predecessor ScheduleTask @relation("ScheduleTaskLinkPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  successor   ScheduleTask @relation("ScheduleTaskLinkSuccessor", fields: [successorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([predecessorId, successorId])
  @@index([projectId])
  @@index([successorId])
  @@map("schedule_task_link")
}

