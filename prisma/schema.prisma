model PendingSignup {
  id           Int      @id(map: "PK_2d0b029dacccf96f58b57635e6c") @default(autoincrement())
  email        String   @unique(map: "UQ_535c0b5f98ba76bef7d9abb993b") @db.VarChar
  fullName     String   @db.VarChar
  password     String   @db.VarChar
  otpCode      String   @db.VarChar
  otpExpiresAt DateTime @db.Timestamp(6)
  attempts     Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  @@map("pending_signup")
}

/// A boiler/plant operator's daily log entry — steam, water, pellet stock,
/// burner status. One row per organization per calendar date (enforced by
/// the unique index below); derived figures (steam ton, water flow, pellet
/// stock closing) are computed by the API from the raw readings rather than
/// stored as separate columns, so there's no chance of them drifting out of
/// sync with the readings they're derived from.
model PlantDailyReport {
  id             Int      @id @default(autoincrement())
  organizationId Int
  /// Which plant/project this day's log belongs to — an organization can run
  /// more than one plant, each logged (and totaled) separately.
  projectId      Int?
  date           DateTime @db.Date

  steamInitial  Decimal? @db.Decimal
  steamFinal    Decimal? @db.Decimal
  steamPressure Decimal? @db.Decimal
  steamTemp     Decimal? @db.Decimal
  feedwaterTemp Decimal? @db.Decimal

  pelletUsedKg       Decimal? @db.Decimal
  pelletsBag         Decimal? @db.Decimal
  pelletReceivedKg   Decimal? @db.Decimal
  /// Snapshotted at creation from the previous day's closing balance for
  /// this organization (0 if there's no prior entry) — never edited by hand.
  pelletStockOpening Decimal? @db.Decimal

  waterInitial Decimal? @db.Decimal
  waterFinal   Decimal? @db.Decimal

  burnerStatus   String?  @db.VarChar
  burnerHours    Decimal? @db.Decimal
  /// Required by the API whenever steam ton works out to 0 or burnerStatus
  /// is "stopped" — see PlantReportController.
  shutdownReason String?

  /// Values for this organization's custom fields (see PlantReportCustomField),
  /// keyed by field id (as a JSON string key) -> string | number | boolean | null.
  /// Stored loosely rather than in a normalized value table since fields are
  /// low-cardinality and org-defined; a deleted field just leaves an orphaned,
  /// ignored key behind instead of requiring a cleanup pass.
  customValues Json?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  staff        PlantReportStaff[]
  itemEntries  PlantReportItemEntry[]

  @@unique([organizationId, projectId, date])
  @@map("plant_daily_report")
}

/// Which staff were present for a given day's plant report — a join table
/// instead of a text list so the "staff present" count is always derived
/// from real rows, never typed (and thus never drifts) separately.
model PlantReportStaff {
  id       Int @id @default(autoincrement())
  reportId Int
  userId   Int

  report PlantDailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@map("plant_report_staff")
}

/// An org-defined extra column for the daily plant report form — e.g. "Ash
/// Removed (kg)" as a number field, or "Inspector Notes" as text. Values are
/// stored per-report in PlantDailyReport.customValues, keyed by this field's
/// id; dataType is enforced in the application layer (PlantReportController),
/// not as a Postgres enum, so new types can be added without a migration.
model PlantReportCustomField {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String   @db.VarChar
  /// "text" | "number" | "date" | "boolean"
  dataType       String   @db.VarChar
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("plant_report_custom_field")
}

/// An org-defined consumable/material tracked on the daily plant report —
/// e.g. "Pellets" (kg), "Diesel" (litre), "Caustic Soda" (kg). Each item gets
/// its own running stock ledger across reports, the same way pellets do
/// today. Distinct from PlantReportCustomField, which is for flat one-off
/// values with no opening/closing balance semantics.
model PlantReportItem {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String   @db.VarChar
  /// Display-only unit label — "kg", "ltr", "bag", "pcs", etc.
  unit           String   @db.VarChar
  /// false = just log usage for this item, no opening/closing ledger.
  trackStock     Boolean  @default(true)
  /// Soft-disable instead of deleting, so past reports keep their history.
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      PlantReportItemEntry[]

  @@unique([organizationId, name])
  @@map("plant_report_item")
}

/// One item's reading on one day's report. openingStock is snapshotted at
/// creation the same way PlantDailyReport.pelletStockOpening is — carried
/// forward from the previous report's closing balance for this item+project,
/// never edited by hand. closingStock is derived (opening + received - used),
/// not stored, to avoid drift — same pattern as steamTon/pelletStockClosing
/// in PlantReportController today.
model PlantReportItemEntry {
  id           Int      @id @default(autoincrement())
  reportId     Int
  itemId       Int
  openingStock Decimal? @db.Decimal(12, 3)
  receivedQty  Decimal? @db.Decimal(12, 3)
  usedQty      Decimal? @db.Decimal(12, 3)
  note         String?

  report PlantDailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  item   PlantReportItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([reportId, itemId])
  @@map("plant_report_item_entry")
}

model ProcurementAttachment {
  id                Int              @id(map: "PK_7daf4aef8c39d882b308044813f") @default(autoincrement())
  fileName          String           @db.VarChar
  filePath          String           @db.VarChar
  createdAt         DateTime         @default(now()) @db.Timestamp(6)
  uploadedById      Int?
  procurementItemId Int?
  procurementItem   ProcurementItem? @relation(fields: [procurementItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_608fffab95a5c24356850767cbf")
  uploadedBy        User?            @relation(fields: [uploadedById], references: [id], onUpdate: NoAction, map: "FK_d719e36702a5589c5bc8d293468")

  @@map("procurement_attachment")
}

model ProcurementItem {
  id              Int       @id(map: "PK_58dd75ddfa3fb86cad02d0dea32") @default(autoincrement())
  itemName        String    @db.VarChar
  quantity        Int       @default(1)
  estimatedCost   Decimal?  @db.Decimal
  neededByDate    DateTime? @db.Date
  notes           String?
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  requestedById   Int?
  projectId       Int?
  organizationId  Int?      @map("workspaceId")
  category        String    @default("hardware") @db.VarChar
  status          String    @default("pending") @db.VarChar
  poNumber        String?   @db.VarChar
  unitCost        Decimal?  @db.Decimal
  vendorName      String?   @db.VarChar
  vendorId        Int?
  itemId          Int?
  unit            String?   @db.VarChar
  taxPercent      Decimal?  @db.Decimal
  discountPercent Decimal?  @db.Decimal
  transportCost   Decimal?  @db.Decimal
  customsCost     Decimal?  @db.Decimal

  attachments   ProcurementAttachment[]
  organization  Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_60c7d17e44ffa1db2d1d1a90c08")
  item          CatalogItem?               @relation(fields: [itemId], references: [id], onUpdate: NoAction, map: "FK_962531b78f7e84a1af9bbed3c5c")
  requestedBy   User?                      @relation(fields: [requestedById], references: [id], onUpdate: NoAction, map: "FK_af07f3da6e978a7e1fc31c777be")
  vendor        Vendor?                    @relation(fields: [vendorId], references: [id], onUpdate: NoAction, map: "FK_c491225838280a413ee9b77c407")
  project       Project?                   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_e13850e5ad77122dc1b16cec387")
  statusHistory ProcurementStatusHistory[]

  @@map("procurement_item")
}

model ProcurementStatusHistory {
  id                Int              @id(map: "PK_86317a5b57832295d35505b6bb9") @default(autoincrement())
  fromStatus        String?          @db.VarChar
  toStatus          String           @db.VarChar
  notes             String?
  createdAt         DateTime         @default(now()) @db.Timestamp(6)
  changedById       Int?
  procurementItemId Int?
  procurementItem   ProcurementItem? @relation(fields: [procurementItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_97498b499ec7e4bf975c91b94b4")
  changedBy         User?            @relation(fields: [changedById], references: [id], onUpdate: NoAction, map: "FK_b6176ad2735eee052610b6e011f")

  @@map("procurement_status_history")
}

// ---------------------------------------------------------------------------
// Procurement pipeline v2: Purchase Request -> Vendor Selection -> Purchase
// Order -> Proforma Invoice -> (Local/International) Shipment/Insurance/
// Customs -> Cost Sheet (computed) -> Goods Receipt -> Inventory. Brand-new
// tables (no legacy "workspace" naming pin needed) that replace the old flat
// ProcurementItem flow going forward; ProcurementItem/ProcurementAttachment/
// ProcurementStatusHistory above stay in the DB untouched for historical
// data (see src/utils/migrate-procurement-to-pr-po.ts).
// ---------------------------------------------------------------------------

model PurchaseRequest {
  id                            Int      @id @default(autoincrement())
  prNumber                      String?  @db.VarChar
  department                    String?  @db.VarChar
  priority                      String   @default("medium") @db.VarChar
  reason                        String?
  status                        String   @default("draft") @db.VarChar
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @default(now()) @updatedAt
  requestedById                 Int?
  projectId                     Int?
  organizationId                Int?
  /// Set only for PRs created by the one-off historical-data migration script; @unique makes the migration idempotent.
  migratedFromProcurementItemId Int?     @unique

  requestedBy   User?                          @relation(fields: [requestedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  project       Project?                       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization  Organization?                  @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items         PurchaseRequestItem[]
  attachments   PurchaseRequestAttachment[]
  statusHistory PurchaseRequestStatusHistory[]
  vendorQuotes  VendorQuote[]
  purchaseOrder PurchaseOrder?

  @@map("purchase_request")
}

model PurchaseRequestItem {
  id                Int      @id @default(autoincrement())
  itemName          String   @db.VarChar
  quantity          Int      @default(1)
  unit              String?  @db.VarChar
  estimatedPrice    Decimal? @db.Decimal
  notes             String?
  createdAt         DateTime @default(now())
  purchaseRequestId Int?
  itemId            Int?

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item            CatalogItem?     @relation(fields: [itemId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("purchase_request_item")
}

model PurchaseRequestAttachment {
  id                Int      @id @default(autoincrement())
  fileName          String   @db.VarChar
  filePath          String   @db.VarChar
  /// "general" | "quotation" | "comparison_sheet" — see PurchaseRequestAttachmentType in types/domain.ts
  documentType      String   @default("general") @db.VarChar
  createdAt         DateTime @default(now())
  uploadedById      Int?
  purchaseRequestId Int?

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploadedBy      User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("purchase_request_attachment")
}

model PurchaseRequestStatusHistory {
  id                Int      @id @default(autoincrement())
  fromStatus        String?  @db.VarChar
  toStatus          String   @db.VarChar
  notes             String?
  createdAt         DateTime @default(now())
  changedById       Int?
  purchaseRequestId Int?

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changedBy       User?            @relation(fields: [changedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("purchase_request_status_history")
}

/// One "possible vendor" option in the Vendor Selection step; the row with isSelected=true is what "Generate Purchase Order" reads.
model VendorQuote {
  id                Int      @id @default(autoincrement())
  price             Decimal  @db.Decimal
  notes             String?
  isSelected        Boolean  @default(false)
  createdAt         DateTime @default(now())
  purchaseRequestId Int?
  vendorId          Int?

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendor          Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("vendor_quote")
}

model PurchaseOrder {
  id                Int       @id @default(autoincrement())
  poNumber          String?   @db.VarChar
  deliveryAddress   String?
  paymentTerms      String?   @db.VarChar
  deliveryDate      DateTime? @db.Date
  incoterms         String?   @db.VarChar
  taxPercent        Decimal?  @db.Decimal
  terms             String?
  /// Free-text shipping arrangement for the PO PDF (e.g. "Ex-factory, Bhiwadi, Rajasthan") — distinct from `incoterms`.
  shippingTerms     String?
  /// Free-text delivery period for the PO PDF (e.g. "Within 6 weeks of submission of PO.") — distinct from `deliveryDate`, which is a specific date.
  deliveryPeriod    String?
  finalDestination  String?
  /// "local" | "international" — drives whether Insurance/Customs apply, see PurchaseType in types/domain.ts
  purchaseType      String    @default("local") @db.VarChar
  status            String    @default("created") @db.VarChar
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  purchaseRequestId Int?      @unique
  vendorId          Int?
  projectId         Int?
  organizationId    Int?

  purchaseRequest  PurchaseRequest?             @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  vendor           Vendor?                      @relation(fields: [vendorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  project          Project?                     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization     Organization?                @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items            PurchaseOrderItem[]
  attachments      PurchaseOrderAttachment[]
  statusHistory    PurchaseOrderStatusHistory[]
  proformaInvoices ProformaInvoice[]
  shipment         Shipment?
  goodsReceipts    GoodsReceipt[]

  @@map("purchase_order")
}

/// Snapshot copy of the selected PurchaseRequestItem rows at PO-generation time — not a live reference, so the PO stays stable if the PR is later edited.
model PurchaseOrderItem {
  id              Int      @id @default(autoincrement())
  itemName        String   @db.VarChar
  quantity        Int      @default(1)
  unit            String?  @db.VarChar
  unitPrice       Decimal? @db.Decimal
  notes           String?
  /// HS (Harmonized System) customs code for the PO PDF's line-item table — filled in manually, usually only relevant for international purchases.
  hsnCode         String?  @db.VarChar
  createdAt       DateTime @default(now())
  purchaseOrderId Int?
  itemId          Int?

  purchaseOrder     PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item              CatalogItem?       @relation(fields: [itemId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  goodsReceiptItems GoodsReceiptItem[]

  @@map("purchase_order_item")
}

model PurchaseOrderAttachment {
  id              Int      @id @default(autoincrement())
  fileName        String   @db.VarChar
  filePath        String   @db.VarChar
  createdAt       DateTime @default(now())
  uploadedById    Int?
  purchaseOrderId Int?

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploadedBy    User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("purchase_order_attachment")
}

model PurchaseOrderStatusHistory {
  id              Int      @id @default(autoincrement())
  fromStatus      String?  @db.VarChar
  toStatus        String   @db.VarChar
  notes           String?
  createdAt       DateTime @default(now())
  changedById     Int?
  purchaseOrderId Int?

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changedBy     User?          @relation(fields: [changedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("purchase_order_status_history")
}

model ProformaInvoice {
  id              Int       @id @default(autoincrement())
  piNumber        String?   @db.VarChar
  piDate          DateTime? @db.Date
  currency        String    @default("NPR") @db.VarChar
  exchangeRate    Decimal   @default(1) @db.Decimal
  paymentTerms    String?   @db.VarChar
  validityDate    DateTime? @db.Date
  /// Single PDF attachment per spec ("Attachment (PDF)") — not a join table since only one file is expected.
  fileName        String?   @db.VarChar
  filePath        String?   @db.VarChar
  status          String    @default("waiting") @db.VarChar
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  purchaseOrderId Int?

  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items         ProformaInvoiceItem[]

  @@map("proforma_invoice")
}

model ProformaInvoiceItem {
  id                Int      @id @default(autoincrement())
  itemName          String   @db.VarChar
  quantity          Int      @default(1)
  unit              String?  @db.VarChar
  unitPrice         Decimal? @db.Decimal
  createdAt         DateTime @default(now())
  proformaInvoiceId Int?
  itemId            Int?

  proformaInvoice ProformaInvoice? @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item            CatalogItem?     @relation(fields: [itemId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("proforma_invoice_item")
}

/// Serves both Local and International purchases (spec: "everything afterwards depends on [purchase type]") — Local just never gets an Insurance/Customs child row.
model Shipment {
  id                Int       @id @default(autoincrement())
  shipmentNo        String?   @db.VarChar
  transportMode     String    @default("road") @db.VarChar
  transportCompany  String?   @db.VarChar
  containerNo       String?   @db.VarChar
  vehicleNo         String?   @db.VarChar
  trackingNo        String?   @db.VarChar
  etd               DateTime? @db.Date
  eta               DateTime? @db.Date
  arrivalDate       DateTime? @db.Date
  status            String    @default("booked") @db.VarChar
  freightCost       Decimal?  @db.Decimal
  loadingCost       Decimal?  @db.Decimal
  unloadingCost     Decimal?  @db.Decimal
  fuelCost          Decimal?  @db.Decimal
  miscellaneousCost Decimal?  @db.Decimal
  /// Local-purchase-only cost line (spec's "Local Taxes" under the Local workflow).
  localTaxCost      Decimal?  @db.Decimal
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  purchaseOrderId   Int?      @unique

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  insurance     Insurance?
  customs       Customs?

  @@map("shipment")
}

/// Optional, only created for shipments where it's applicable (per spec: "Only if applicable").
model Insurance {
  id                 Int      @id @default(autoincrement())
  insuranceCompany   String?  @db.VarChar
  policyNumber       String?  @db.VarChar
  coverage           Decimal? @db.Decimal
  premium            Decimal? @db.Decimal
  claimStatus        String?  @db.VarChar
  attachmentFileName String?  @db.VarChar
  attachmentFilePath String?  @db.VarChar
  createdAt          DateTime @default(now())
  shipmentId         Int?     @unique

  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("insurance")
}

/// International purchases only.
model Customs {
  id                      Int      @id @default(autoincrement())
  customDeclarationNumber String?  @db.VarChar
  billOfEntry             String?  @db.VarChar
  hsCode                  String?  @db.VarChar
  clearingAgent           String?  @db.VarChar
  port                    String?  @db.VarChar
  importDuty              Decimal? @db.Decimal
  vat                     Decimal? @db.Decimal
  excise                  Decimal? @db.Decimal
  serviceCharge           Decimal? @db.Decimal
  documentationCost       Decimal? @db.Decimal
  inspectionCost          Decimal? @db.Decimal
  warehouseCost           Decimal? @db.Decimal
  miscellaneousCost       Decimal? @db.Decimal
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt
  shipmentId              Int?     @unique

  shipment  Shipment?         @relation(fields: [shipmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  documents CustomsDocument[]

  @@map("customs")
}

model CustomsDocument {
  id           Int      @id @default(autoincrement())
  /// "bill_of_lading" | "commercial_invoice" | "packing_list" | "certificate_of_origin" | "insurance_certificate" | "other"
  documentType String   @default("other") @db.VarChar
  fileName     String   @db.VarChar
  filePath     String   @db.VarChar
  createdAt    DateTime @default(now())
  customsId    Int?

  customs Customs? @relation(fields: [customsId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("customs_document")
}

/// Inventory only increases once a GoodsReceipt is accepted (see GoodsReceiptController) — replaces the old status="delivered" auto-fold-in behavior.
model GoodsReceipt {
  id               Int      @id @default(autoincrement())
  grnNumber        String?  @db.VarChar
  inspectionResult String?
  status           String   @default("pending_inspection") @db.VarChar
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  purchaseOrderId  Int?
  /// Nullable to accommodate historical rows created by the one-off migration script where the original warehouse can't always be determined.
  warehouseId      Int?
  receivedById     Int?

  purchaseOrder PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  warehouse     Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  receivedBy    User?               @relation(fields: [receivedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items         GoodsReceiptItem[]
  photos        GoodsReceiptPhoto[]

  @@map("goods_receipt")
}

model GoodsReceiptItem {
  id                  Int      @id @default(autoincrement())
  receivedQuantity    Int      @default(0)
  damagedQuantity     Int      @default(0)
  createdAt           DateTime @default(now())
  goodsReceiptId      Int?
  purchaseOrderItemId Int?

  goodsReceipt      GoodsReceipt?      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("goods_receipt_item")
}

model GoodsReceiptPhoto {
  id             Int      @id @default(autoincrement())
  fileName       String   @db.VarChar
  filePath       String   @db.VarChar
  createdAt      DateTime @default(now())
  goodsReceiptId Int?

  goodsReceipt GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("goods_receipt_photo")
}

model Project {
  id                 Int       @id(map: "PK_4d68b1358bb5b766d3e78f32f57") @default(autoincrement())
  name               String    @db.VarChar
  description        String?
  createdAt          DateTime  @default(now()) @db.Timestamp(6)
  dueDate            DateTime? @db.Date
  status             String    @default("pending") @db.VarChar
  priority           String    @default("medium") @db.VarChar
  organizationId     Int?      @map("workspaceId")
  contractDate       DateTime? @db.Date
  kickoffDate        DateTime? @db.Date
  estimatedTotalCost Decimal?  @db.Decimal
  sellingPrice       Decimal?  @db.Decimal

  dailyGeneration    DailyGeneration[]
  inventoryItems     InventoryItem[]
  monthlyPerformance MonthlyPerformance[]
  plantDailyReports  PlantDailyReport[]
  procurementItems   ProcurementItem[]
  purchaseRequests   PurchaseRequest[]
  purchaseOrders     PurchaseOrder[]
  organization       Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_c224ab17df530651e53a398ed92")
  assignees          ProjectAssignee[]
  files              ProjectFile[]
  headings           ProjectHeading[]
  scheduleTasks      ScheduleTask[]
  scheduleTaskLinks  ScheduleTaskLink[]
  projectTasks       Task[]
  taskLinks          TaskLink[]

  @@map("project")
}

model ProjectAssignee {
  projectId Int
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "FK_3304439ccc298271dba101e2dec")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "FK_de3a9d4c1d1f56d5393775ea4a7")

  @@id([projectId, userId], map: "PK_ed4e176ad277bc55fc5bd6ee8dc")
  @@index([userId], map: "IDX_3304439ccc298271dba101e2de")
  @@index([projectId], map: "IDX_de3a9d4c1d1f56d5393775ea4a")
  @@map("project_assignees_user")
}

model ProjectFile {
  id             Int           @id(map: "PK_9e8bbc6ccf0af1d25fbfcddcc80") @default(autoincrement())
  name           String        @db.VarChar
  isFolder       Boolean       @default(false)
  type           String?       @db.VarChar
  parentId       Int?
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  projectId      Int?
  organizationId Int?          @map("workspaceId")
  size           Int?
  path           String?       @db.VarChar
  version        String        @default("v1.0") @db.VarChar
