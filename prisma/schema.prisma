model MyTask {
  id             Int           @id(map: "PK_5afe456c29a460d171e33a42c22") @default(autoincrement())
  title          String        @db.VarChar
  description    String?
  dueDate        DateTime?     @db.Date
  status         String        @default("pending") @db.VarChar
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  userId         Int?
  organizationId Int?          @map("workspaceId")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_6574ade0f1b9a8a753cd2888849")
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_7ce02825b211eb0f6c8515324e4")

  @@map("my_task")
}

/// Per-user, real-time notification (task assignment/completion, approval
/// request submitted/decided, announcement posted) — see notificationService.ts,
/// which creates these and pushes a matching socket.io event in one call.
model Notification {
  id             Int      @id @default(autoincrement())
  /// "task_assigned" | "task_completed" | "approval_requested" | "approval_decided" | "announcement"
  type           String   @db.VarChar
  title          String   @db.VarChar
  message        String
  /// Frontend route to deep-link into when clicked (e.g. a task or approvals page), organization prefix included.
  link           String?  @db.VarChar
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  userId         Int
  organizationId Int?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, isRead, createdAt])
  @@map("notification")
}

model PasswordResetOtp {
  id           Int      @id(map: "PK_74d5385a35ac0c619ca93815200") @default(autoincrement())
  email        String   @unique(map: "UQ_f064c1cfedfb0aca0a334aaa967") @db.VarChar
  otpCode      String   @db.VarChar
  otpExpiresAt DateTime @db.Timestamp(6)
  attempts     Int      @default(0)
