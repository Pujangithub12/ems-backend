model Task {
  id                         Int             @id(map: "PK_fb213f79ee45060ba925ecd576e") @default(autoincrement())
  title                      String          @db.VarChar
  description                String?
  dueDate                    DateTime        @db.Timestamp(6)
  createdAt                  DateTime        @default(now()) @db.Timestamp(6)
  priority                   String          @default("medium") @db.VarChar
  status                     String          @default("to_do") @db.VarChar
  projectId                  Int?
  progress                   Int             @default(0)
  projectHeadingId           Int?
  /// Physically `text` holding a comma-joined string — TypeORM's simple-array
  /// (de)serialized this transparently; app code must now split/join manually.
  files                      String?
  projectName                String?         @db.VarChar
  createdById                Int?
  organizationId             Int?            @map("workspaceId")
  /// Gantt hierarchy (Schedule tab) — self-referential, arbitrary depth.
  /// Independent of projectHeadingId, which stays the orthogonal Kanban
  /// grouping concept; a task can have both.
  parentTaskId               Int?
  /// Gantt-only (Schedule tab). dueDate above stays the Kanban-owned
  /// deadline; the two are never auto-synced.
  startDate                  DateTime?       @db.Date
  /// Gantt-only (Schedule tab). 0 = milestone.
  duration                   Float?
  /// Sibling order among same-parentTaskId tasks (or top-level when null) —
  /// drives Gantt/WBS ordering. Independent of projectHeadingId grouping.
  orderIndex                 Int             @default(0)
  /// Set only by migrate-schedule-to-task.ts; marks the legacy ScheduleTask
  /// this row was migrated from, and makes that script idempotent.
  migratedFromScheduleTaskId Int?            @unique
  activities                 Activity[]
  subTasks                   SubTask[]
  project                    Project?        @relation(fields: [projectId], references: [id], onUpdate: NoAction, map: "FK_3797a20ef5553ae87af126bc2fe")
  createdBy                  User?           @relation(fields: [createdById], references: [id], onUpdate: NoAction, map: "FK_91d76dd2ae372b9b7dfb6bf3fd2")
  projectHeading             ProjectHeading? @relation(fields: [projectHeadingId], references: [id], onUpdate: NoAction, map: "FK_b39775a45b2597e07036bf805ef")
  organization               Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_ce8f24979af169c6cd19cc94e52")
  assignedUsers              TaskAssignee[]
  comments                   TaskComment[]
  parentTask                 Task?           @relation("TaskParent", fields: [parentTaskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  childTasks                 Task[]          @relation("TaskParent")
  outgoingLinks              TaskLink[]      @relation("TaskLinkPredecessor")
  incomingLinks              TaskLink[]      @relation("TaskLinkSuccessor")

  @@index([projectId, parentTaskId])
  @@map("task")
}

/// Dependency link between two Task rows within the same project —
/// MS-Project-style FS/SS/FF/SF relationship with an optional lag/lead
/// (lagDays, negative = lead/overlap). Record-and-display only: no
/// auto-scheduling recompute here. FK-backed successor to the deprecated
/// ScheduleTaskLink, now pointed at Task instead of ScheduleTask.
model TaskLink {
  id                Int      @id @default(autoincrement())
  projectId         Int
  predecessorTaskId Int
  successorTaskId   Int
  /// FS | SS | FF | SF
  type              String   @default("FS") @db.VarChar
  lagDays           Float    @default(0)
  createdAt         DateTime @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  predecessor Task    @relation("TaskLinkPredecessor", fields: [predecessorTaskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  successor   Task    @relation("TaskLinkSuccessor", fields: [successorTaskId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([predecessorTaskId, successorTaskId])
  @@index([projectId])
  @@index([successorTaskId])
  @@map("task_link")
}

